{
  "expo": {
    "name": "Smart Guide",
    "slug": "smart-guide",
    "scheme": "smartguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartguide.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Permitir uso da câmera para escanear o QR Code de conexão ao servidor Smart Guide.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.smartguide.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F39C12"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir uso da câmera para escanear o QR Code do servidor Smart Guide."
        }
      ],
      "expo-web-browser",
      "expo-video"
    ]
  }
}
