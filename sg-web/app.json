{
  "expo": {
    "name": "Smart Guide",
    "slug": "smart-guide",
    "scheme": "smartguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartguide.app"
    },
    "android": {
      "package": "com.smartguide.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F39C12"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-asset"
    ]
  }
}
