# ==============================================================================
# Smart Guide (Open Source) — Global Self-Hosted Configuration (.env)
# ==============================================================================
# Copy this file to `.env` in `public/` before starting Docker Compose or local dev:
#   cp .env.example .env
#
# Never commit `.env` with real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Localization
# ------------------------------------------------------------------------------
NODE_ENV=production
INSTANCE_NAME=Smart Guide
# Supported locales: pt-BR, en, es
APP_DEFAULT_LOCALE=pt-BR

# ------------------------------------------------------------------------------
# 2. Network, Ports, Public URLs & CORS
# ------------------------------------------------------------------------------
API_PORT=3000
WEB_PORT=8080
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:8080
# Comma-separated list of allowed browser origins (do not use * in production)
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_guide
POSTGRES_USER=smart_guide
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://smart_guide:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/smart_guide

# ------------------------------------------------------------------------------
# 4. Better Auth & Social OAuth (Google / Microsoft Entra ID)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_32_PLUS_BYTES_RANDOM_HEX
BETTER_AUTH_URL=http://localhost:3000

AUTH_ALLOW_EMAIL_PASSWORD=true
AUTH_ALLOW_PUBLIC_SIGNUP=false

# Google OAuth (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Azure AD OAuth (leave empty to disable Microsoft sign-in)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Deep-link scheme for mobile OAuth callback allowlist (e.g. smartguide://auth-callback)
MOBILE_APP_SCHEME=smartguide

# ------------------------------------------------------------------------------
# 5. Media Storage Connector (local | s3 | azure)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_MAX_IMAGE_MB=10
STORAGE_MAX_VIDEO_MB=150
# When false, media routes require an authenticated session or short-lived HMAC token
STORAGE_PUBLIC_MEDIA=false

# Local Disk Storage (when STORAGE_DRIVER=local)
LOCAL_STORAGE_PATH=./uploads

# S3-Compatible Storage (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=smart-guide-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Azure Blob Storage (when STORAGE_DRIVER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=smart-guide-media

# ------------------------------------------------------------------------------
# 6. Initial Admin Seed (Idempotent: runs only if no admin user exists yet)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
SEED_ADMIN_NAME=Administrator

# ------------------------------------------------------------------------------
# 7. Optional Mobile License & Outbound Relay Tunnel (Opt-In)
# ------------------------------------------------------------------------------
# Leave empty for standard self-hosted web/LAN usage.
SG_LICENSE_KEY=
SG_CLOUD_RELAY_URL=

# ------------------------------------------------------------------------------
# 8. Web & Mobile Client Build-Time Public Variables (sg-web)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DEFAULT_LOCALE=pt-BR
